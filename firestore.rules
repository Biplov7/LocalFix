rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Roles are stored in user documents. Only a server-side Admin SDK should
    // assign the first admin role; clients cannot promote themselves.
    function isAdmin() {
      return signedIn()
          && get(/databases/$(database)/documents/user/$(request.auth.uid))
              .data.role == 'admin';
    }

    match /user/{userId} {
      // A new Firebase Auth user can create only their own customer profile.
      allow create: if isOwner(userId)
          && request.resource.data.id == userId
          && request.resource.data.role == 'customer';
      allow read: if isOwner(userId) || isAdmin();
      // A user may update their own profile but cannot change their role.
      allow update: if (isOwner(userId)
              && request.resource.data.id == userId
              && request.resource.data.role == resource.data.role)
          || isAdmin();
      allow delete: if isAdmin();
    }

    match /service_categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
